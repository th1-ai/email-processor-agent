{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(runs/**)",
      "Bash({{EMAIL_CLI}} *)",
      "Bash({{PMS_LOOKUP_TOOL}} *)",
      "Bash({{DRAFT_REPLY_TOOL}} *)",
      "Bash({{DRAFT_NEW_TOOL}} *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(AUTONOMY.md)",
      "Edit(.claude/**)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/autonomy_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
