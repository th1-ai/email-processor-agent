# Email Processor Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# The skill file does not read this file. It uses the values you
# put in place of the double-brace placeholders in
# .claude/skills/email-processor/SKILL.md. Keep this file if your
# own wrappers and scripts load their settings from `.env`, and
# keep the two in step. Add your wrappers' own credentials here.

# ============================================================
# Email accounts the processor will scan
# ============================================================
# Same values as the three inbox placeholders in the skill file.
# Delete INBOX_RENTALS if you have no such inbox.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
# Wrapper that switches between accounts and reads / lists
# messages, plus reads/writes the inbox-tracking spreadsheet.
# Reference setup uses a Gmail / Google Workspace wrapper
# called `gws`. Same value as {{EMAIL_CLI}}.

EMAIL_CLI="gws"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The processor uses this to verify booking claims and
# classify guest messages.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"

# ============================================================
# Email-Inbox tracking sheet
# ============================================================
# A Google Sheet (or any provider sheet) with two tabs:
#   Inbox  — one row per processed email
#   Config — last-check timestamps per account

SHEET_ID_INBOX=""

# ============================================================
# Draft helpers
# ============================================================
# Create a draft only. They must not be able to send.
# Same values as {{DRAFT_REPLY_TOOL}} and {{DRAFT_NEW_TOOL}}.

DRAFT_REPLY_TOOL="tools/create_draft_reply.py"
DRAFT_NEW_TOOL="tools/create_draft_email.py"

# ============================================================
# Operator identity (sign-offs and routing)
# ============================================================
OPERATOR_NAME=""
HOTEL_NAME=""
